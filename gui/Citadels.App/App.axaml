<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Citadels.App.ViewModels"
             xmlns:views="using:Citadels.App.Views"
             x:Class="Citadels.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Citadels/Styles/Theme.axaml" />
  </Application.Styles>

  <!-- Which view shows which view model. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:SetupViewModel">
      <views:SetupView />
    </DataTemplate>
    <DataTemplate DataType="vm:GameViewModel">
      <views:GameView />
    </DataTemplate>
    <DataTemplate DataType="vm:CardViewModel">
      <views:CardView />
    </DataTemplate>
  </Application.DataTemplates>

</Application>
